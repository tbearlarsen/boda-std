---
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n/ui';
import { Image } from 'astro:assets';
import heroPhoto from '../../assets/images/IMG_9486.JPG';
import selfiePhoto from '../../assets/images/IMG_9751.jpeg';

const t = useTranslations('da');

// Decorative text (heading, photo captions, hints, quote) intentionally
// stays in English for now — only the letter itself is translated.
// See description.da.md for source.
const excitedHeading = "We're Getting Married!";

// Verbatim from description.da.md, split on blank lines into paragraphs and
// on single line breaks within a paragraph. Section headings kept in
// English to match description.da.md.
const letterIntro: string[][] = [
  ['Kæreste familie og venner,'],
  [
    'Efter RIGTIG MANGE års drømmen om dette øjeblik (Lorena) og seriøs bekymring om vores økonomi (Thorbjørn), er tiden endelig kommet... vi skal giftes! 💍',
  ],
  [
    'Sidste år, under vores roadtrip rundt i de skønne franske bjerge, og efter en mindre krise omhandlende Lorenas insisteren på at købe den næste bog i den serie hun var i gang med at læse, endte vi med at overnatte i et af de smukkeste steder vi har været. God mad og vin, en fantastisk udsigt, og en solnedgang der ikke er til at glemme, førte alle til det helt igennem magiske øjeblik, der selvfølgelig kaldte på at Thorbjørn skulle på knæ. Og nu, efter hvad der føles som års planlægning, spænding, nervøsitet og et par budgetrelaterede kriser undervejs, nærmer den store dag sig! 🥹❤️',
  ],
  ['Vi glæder os så utroligt meget til at fejre denne særlige dag med jer alle. Det ville simpelthen ikke være det samme uden alle de mennesker vi elsker.'],
];

const letterBody: string[][] = [
  [
    'Datoen det drejer sig om, er den 5. juni. Vi har fundet et virkelig dejligt sted i bjergene nord for Madrid. Ja, Madrid, som i Spanien. Godt vejr og fantastisk mad. Vi er selvfølgelig udmærket godt klar over at det er meget at bede om at i skal rejse til et andet land for at deltage i vores bryllup. Vi håber dog at i vil holde jeres indre Bilbo Baggins i mende og gøre jer klar til årets eventyr! Vi ville simpelthen elske at dele vores dag med jer.',
  ],
  [
    'Indtil videre er jeres eneste opgave at sætte hak i kalenderen (i ved i har lyst til at trykke på den belejlige Gem Datoen knap), og begynde at varme op til at ramme floor. ***Vi forventer en sund blanding af tvivlsomme bryllupskoreografier, klassiske festmoves, entusiastisk medsang, imponerende fardans og selvfølgelig alt det, der falder naturligt, når musikken går i gang. 💃🕺***',
  ],
  ['✈️ Hvordan fanden kommer vi frem?'],
  [
    'Rejser i til Spanien udenlands fra, så har Madrid en stor international lufthavn, Adolfo Suárez Madrid-Barajas, der er nem at komme til. Så i får en venlig lille forespørgsel om at begynde at kigge på fly osv.',
  ],
  ['🛏️ Overnatning'],
  [
    'Hvad angår overnatning, er der en landsby 10 minutter fra stedet med masser af hoteller. Det overrasker jer nok ikke, at vi stadig er i planlægningsfasen og stadig i gang med at få styr på det hele, men vi kommer til at tale med de forskellige steder og prøve at forhandle en bedre pris for alle. Så vent med at booke et værelse indtil videre. Vi deler flere detaljer og informationer med jer i løbet af de kommende måneder.',
  ],
  ['🇪🇸 Hvorfor ikke gøre det til en ferie?'],
  [
    'Hvis I overvejer at blive i Spanien nogle ekstra dage, eller endnu længere, så sig endelig til! Vi vil meget gerne hjælpe jer med at planlægge en skøn spansk ferie når nu i skal til Spanien alligevel.',
  ],
  [
    'Uanset om I vil udforske Madrid, tage ud og opleve de smukke landsbyer, tage til kysten, fråde noget spansk mad og vin, eller bare finde de bedste steder at slappe af og nyde solen, hjælper vi jer meget gerne med at planlægge det. 🇪🇸☀️🍷',
  ],
];

const letterClosing: string[][] = [
  [
    'Vi kan simpelthen ikke vente på, at dagen kommer, på at se jer alle sammen se fantastiske ud i Madrids bjerge, og vigtigst af alt, på at fejre sammen med de mennesker, vi elsker.',
  ],
  ['Masser af kærlighed og et kæmpe kram kram. Vi kan ikke vente med at se jer! ❤️'],
  ['Lorena & Thorbjørn'],
];

// Single-line letterBody entries that should render as section headings
// rather than body text.
const sectionHeadings = new Set([
  '✈️ Hvordan fanden kommer vi frem?',
  '🛏️ Overnatning',
  '🇪🇸 Hvorfor ikke gøre det til en ferie?',
]);

// Minimal inline-markdown support for ***bold italic*** emphasis, since
// description.da.md uses it. Everything else renders as plain text.
function renderLine(line: string) {
  return line.split(/(\*\*\*[^*]+\*\*\*)/g).filter(Boolean).map((part) =>
    part.startsWith('***') && part.endsWith('***')
      ? { emphasis: true, text: part.slice(3, -3) }
      : { emphasis: false, text: part }
  );
}

const venueName = 'Finca Prados Riveros';
const venueAddress = 'Camino del Palero 11, 28740 Rascafría, Madrid, Spain';
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(`${venueName}, ${venueAddress}`)}&output=embed`;

// Deterministic "deckled paper" edge for the photo — a slightly irregular
// outline instead of a sharp rectangle. Fixed seed so it's stable across
// rebuilds instead of reshuffling on every deploy.
function mulberry32(seed: number) {
  return function () {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function deckleEdge(seed: number) {
  const rand = mulberry32(seed);
  const perEdge = 18;
  const amp = 0.65;
  const points: string[] = [];

  const wobble = (t: number) => (Math.sin(t * Math.PI * 4 + seed) * 0.4 + (rand() - 0.5)) * amp;

  const walk = (x0: number, y0: number, x1: number, y1: number, axis: 'x' | 'y') => {
    for (let i = 0; i <= perEdge; i++) {
      const t = i / perEdge;
      const x = x0 + (x1 - x0) * t;
      const y = y0 + (y1 - y0) * t;
      const w = wobble(t + x0 + y0);
      if (axis === 'x') points.push(`${x.toFixed(2)}% ${(y + w).toFixed(2)}%`);
      else points.push(`${(x + w).toFixed(2)}% ${y.toFixed(2)}%`);
    }
  };

  walk(0, 0, 100, 0, 'x');
  walk(100, 0, 100, 100, 'y');
  walk(100, 100, 0, 100, 'x');
  walk(0, 100, 0, 0, 'y');

  return `polygon(${points.join(', ')})`;
}

const deckleClipPath = deckleEdge(7);
const mapDeckleClipPath = deckleEdge(21);
const videoDeckleClipPath = deckleEdge(41);
const selfieDeckleClipPath = deckleEdge(55);
---

<Base title="Thorbjørn & Lorena — Gem Datoen — 5. juni 2027">
  <div class="home">
    <h2 class="excited-heading">{excitedHeading}</h2>

    <div class="photo-wrap">
      <div class="photo-frame">
        <Image src={heroPhoto} alt="Thorbjørn and Lorena" class="hero-photo" style={`clip-path: ${deckleClipPath};`} />
        <span class="corner-mount corner-mount-tl" aria-hidden="true"></span>
        <span class="corner-mount corner-mount-br" aria-hidden="true"></span>
      </div>
      <p class="photo-caption hero-caption">Lover's Bridge,<br />Brugge, 2025</p>
    </div>

    <div class="message">
      {letterIntro.map((paragraph) => (
        <p>
          {paragraph.map((line, i) => (
            <>
              {i > 0 && <br />}
              {renderLine(line).map((seg) => (seg.emphasis ? <strong><em>{seg.text}</em></strong> : seg.text))}
            </>
          ))}
        </p>
      ))}
    </div>

    <div class="photo-wrap video-wrap">
      <div class="photo-frame video-frame">
        <video
          class="hero-photo"
          style={`clip-path: ${videoDeckleClipPath};`}
          src="/proposal.mp4"
          poster="/proposal-poster.jpg"
          autoplay
          loop
          muted
          playsinline
        ></video>
        <span class="corner-mount corner-mount-tl" aria-hidden="true"></span>
        <span class="corner-mount corner-mount-br" aria-hidden="true"></span>
      </div>
      <p class="photo-caption video-caption">
        <a href="https://www.airbnb.com/rooms/24166990" target="_blank" rel="noopener noreferrer" class="secret-link">François' AirBnB,<br />Jouy-aux-Arches,<br />France</a>
      </p>
    </div>

    <div class="photo-wrap second-photo-wrap">
      <div class="photo-frame second-photo-frame">
        <Image src={selfiePhoto} alt="Thorbjørn and Lorena celebrating the proposal" class="hero-photo" style={`clip-path: ${selfieDeckleClipPath};`} />
        <span class="corner-mount corner-mount-tl" aria-hidden="true"></span>
        <span class="corner-mount corner-mount-br" aria-hidden="true"></span>
      </div>
      <p class="photo-caption second-photo-caption">She said yes!</p>
    </div>

    <div class="date-block">
      <div class="date-display">
        <span class="date-rule" aria-hidden="true"></span>
        <span class="date-text">5 June 2027</span>
        <span class="date-rule" aria-hidden="true"></span>
      </div>
      <div class="cta">
        <a href="/save-the-date-da.ics" download="save-the-date.ics" class="save-date-btn">{t('btn.saveTheDate')}</a>
        <span class="click-hint" aria-hidden="true">Click me!</span>
        <span class="click-hint click-hint-2" aria-hidden="true">Pretty please?</span>
      </div>
    </div>

    <div class="message">
      {letterBody.map((paragraph) => {
        const isHeading = paragraph.length === 1 && sectionHeadings.has(paragraph[0]);
        return (
          <p class={isHeading ? 'section-heading' : ''}>
            {paragraph.map((line, i) => (
              <>
                {i > 0 && <br />}
                {renderLine(line).map((seg) => (seg.emphasis ? <strong><em>{seg.text}</em></strong> : seg.text))}
              </>
            ))}
          </p>
        );
      })}
    </div>

    <div class="countdown" id="countdown">
      <div class="unit"><span class="number" id="days">--</span><span class="label">{t('countdown.days')}</span></div>
      <div class="sep">:</div>
      <div class="unit"><span class="number" id="hours">--</span><span class="label">{t('countdown.hours')}</span></div>
      <div class="sep">:</div>
      <div class="unit"><span class="number" id="minutes">--</span><span class="label">{t('countdown.minutes')}</span></div>
      <div class="sep">:</div>
      <div class="unit"><span class="number" id="seconds">--</span><span class="label">{t('countdown.seconds')}</span></div>
    </div>

    <div class="message closing-message">
      {letterClosing.map((paragraph) => (
        <p>
          {paragraph.map((line, i) => (
            <>
              {i > 0 && <br />}
              {renderLine(line).map((seg) => (seg.emphasis ? <strong><em>{seg.text}</em></strong> : seg.text))}
            </>
          ))}
        </p>
      ))}
    </div>

    <div class="venue">
      <p class="venue-name">{venueName}</p>
      <p class="venue-address">{venueAddress}</p>
      <div class="map-frame">
        <iframe
          src={mapSrc}
          width="100%"
          height="320"
          style={`border:0; clip-path: ${mapDeckleClipPath};`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Venue location"
        ></iframe>
        <span class="corner-mount corner-mount-tl" aria-hidden="true"></span>
        <span class="corner-mount corner-mount-br" aria-hidden="true"></span>
      </div>
    </div>

    <p class="lotr-note">Make haste! For it is before the mountains of Rascafría that the doom of our time will be decided</p>
  </div>
</Base>

<script>
  function update() {
    const target = new Date('2027-06-05T13:00:00+02:00'); // 13:00 CEST (Madrid)
    const diff = target.getTime() - Date.now();

    if (diff <= 0) {
      document.getElementById('countdown')!.textContent = '🎉';
      return;
    }

    const days    = Math.floor(diff / 86400000);
    const hours   = Math.floor((diff % 86400000) / 3600000);
    const minutes = Math.floor((diff % 3600000) / 60000);
    const seconds = Math.floor((diff % 60000) / 1000);

    document.getElementById('days')!.textContent    = String(days).padStart(2, '0');
    document.getElementById('hours')!.textContent   = String(hours).padStart(2, '0');
    document.getElementById('minutes')!.textContent = String(minutes).padStart(2, '0');
    document.getElementById('seconds')!.textContent = String(seconds).padStart(2, '0');
  }

  update();
  setInterval(update, 1000);
</script>

<style>
  .home {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    padding: 4rem 2rem;
    text-align: center;
    font-family: Georgia, 'Times New Roman', serif;
    color: #2c2c2c;
  }

  .excited-heading {
    font-family: 'Qwitcher Grypen', cursive;
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 400;
    color: #2c2c2c;
    margin: 0;
  }

  .photo-wrap {
    position: relative;
    width: 60%;
    max-width: 640px;
  }

  .photo-frame {
    position: relative;
    box-sizing: border-box;
    margin: 1.5rem 0;
    transform: rotate(-2deg);
  }

  .video-wrap {
    width: 40%;
    max-width: 427px;
    transform: translateX(6.5rem);
  }

  .video-frame {
    transform: rotate(2deg);
  }

  .second-photo-wrap {
    width: 30%;
    max-width: 320px;
    margin-top: -1rem;
    transform: translateX(-6.5rem);
  }

  .second-photo-frame {
    transform: rotate(-3deg);
  }

  .photo-caption {
    position: absolute;
    top: 50%;
    left: 100%;
    margin-left: 1.5rem;
    width: 190px;
    font-family: 'Homemade Apple', cursive;
    font-size: 1.3rem;
    line-height: 1.5;
    color: #a9773f;
    text-align: left;
    white-space: nowrap;
    transform: translateY(-50%) rotate(3deg);
  }

  .video-caption {
    left: auto;
    right: 100%;
    margin-left: 0;
    margin-right: 1.5rem;
    text-align: right;
    transform: translateY(-50%) rotate(-3deg);
  }

  .secret-link {
    color: inherit;
    text-decoration: none;
  }

  .secret-link:visited,
  .secret-link:hover,
  .secret-link:active,
  .secret-link:focus {
    color: inherit;
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .photo-wrap {
      width: 88%;
    }

    .video-wrap {
      width: 80%;
      transform: none;
    }

    .second-photo-wrap {
      width: 60%;
      margin-top: 0;
      transform: none;
    }

    .photo-caption {
      position: static;
      width: auto;
      margin: 0.5rem 0 0;
      text-align: center;
      white-space: normal;
    }

    .hero-caption {
      transform: rotate(1.5deg);
    }

    .second-photo-caption {
      transform: rotate(1.5deg);
    }

    .video-caption {
      transform: rotate(-1.5deg);
    }
  }

  .hero-photo {
    width: 100%;
    height: auto;
    display: block;
    /* clip-path clips the drop-shadow too, so fake depth with a filter instead */
    filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.14));
  }

  .corner-mount {
    position: absolute;
    width: 9%;
    aspect-ratio: 1;
    pointer-events: none;
    background: rgba(210, 182, 133, 0.8);
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.12));
  }

  .corner-mount-tl {
    top: 0;
    left: 0;
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  .corner-mount-br {
    bottom: 0;
    right: 0;
    clip-path: polygon(100% 100%, 0 100%, 100% 0);
  }

  .message {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 480px;
    font-size: 1rem;
    line-height: 1.7;
    color: #4a4a4a;
  }

  .message p {
    margin: 0;
  }

  .closing-message {
    gap: 2.25rem;
  }

  .message .section-heading {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #2c2c2c;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .date-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 360px;
  }

  .date-display {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    width: 100%;
  }

  .date-rule {
    flex: 1;
    height: 1px;
    max-width: 70px;
    background: #c8c0b4;
  }

  .date-text {
    font-size: 1.4rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #2c2c2c;
    white-space: nowrap;
  }

  .lotr-note {
    max-width: 560px;
    margin-top: -1.75rem;
    font-family: 'Homemade Apple', cursive;
    font-size: 1.1rem;
    line-height: 1.4;
    color: #2c2c2c;
    transform: rotate(0.8deg);
  }

  .venue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
  }

  .venue-name {
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2c2c2c;
  }

  .venue-address {
    font-size: 0.8rem;
    color: #999;
    margin-bottom: 0.5rem;
  }

  .map-frame {
    position: relative;
    width: 100%;
    max-width: 640px;
    box-sizing: border-box;
    margin: 1.5rem 0;
    line-height: 0;
    transform: rotate(-1.5deg);
  }

  .map-frame iframe {
    filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.14));
  }

  .cta {
    position: relative;
    display: inline-flex;
  }

  .save-date-btn {
    display: inline-block;
    padding: 0.65rem 2rem;
    border: 1px solid #c8c0b4;
    color: #2c2c2c;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }

  .save-date-btn:hover {
    background-color: #2c2c2c;
    color: #faf9f7;
  }

  .click-hint {
    position: absolute;
    top: 50%;
    left: 100%;
    margin-left: 1rem;
    font-family: 'Qwitcher Grypen', cursive;
    font-size: 1.9rem;
    color: #c89452;
    white-space: nowrap;
    pointer-events: none;
    animation: hint-float 2.2s ease-in-out infinite;
  }

  @keyframes hint-float {
    0%, 100% { transform: translateY(-50%) rotate(14deg); }
    50%      { transform: translateY(calc(-50% - 6px)) rotate(14deg); }
  }

  .click-hint-2 {
    top: auto;
    left: auto;
    bottom: -1.75rem;
    right: calc(100% + 0.75rem);
    margin-left: 0;
    font-size: 1.5rem;
    animation-name: hint-float-2;
    animation-delay: 0.4s;
  }

  @keyframes hint-float-2 {
    0%, 100% { transform: rotate(-8deg); }
    50%      { transform: translateY(-6px) rotate(-8deg); }
  }

  @media (max-width: 480px) {
    .cta {
      flex-direction: column;
      align-items: center;
    }

    .click-hint {
      position: static;
      display: block;
      margin: 0.5rem 0 0;
    }

    .click-hint-2 {
      animation-delay: 0.4s;
    }

    @keyframes hint-float {
      0%, 100% { transform: translateY(0) rotate(14deg); }
      50%      { transform: translateY(-6px) rotate(14deg); }
    }
  }

  .countdown {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    min-width: 3rem;
  }

  .number {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .label {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #999;
  }

  .sep {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    line-height: 1;
    color: #ccc;
  }
</style>
