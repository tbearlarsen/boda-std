<script>
  function update() {
    const target = new Date('2027-06-05T13:00:00+02:00'); // 13:00 CEST (Madrid)
    const diff = target.getTime() - Date.now();

    if (diff <= 0) {
      document.getElementById('countdown')!.textContent = '🎉';
      return;
    }

    const days    = Math.floor(diff / 86400000);
    const hours   = Math.floor((diff % 86400000) / 3600000);
    const minutes = Math.floor((diff % 3600000) / 60000);
    const seconds = Math.floor((diff % 60000) / 1000);

    document.getElementById('days')!.textContent    = String(days).padStart(2, '0');
    document.getElementById('hours')!.textContent   = String(hours).padStart(2, '0');
    document.getElementById('minutes')!.textContent = String(minutes).padStart(2, '0');
    document.getElementById('seconds')!.textContent = String(seconds).padStart(2, '0');
  }

  update();
  setInterval(update, 1000);

  (function () {
    const paths = Array.from(document.querySelectorAll('.heading-strokes path'));
    if (!paths.length) return;
    const lengths = paths.map((p) => p.getTotalLength());
    const totalLength = lengths.reduce((a, b) => a + b, 0);
    const totalDuration = 5200; // ms

    const segs = [];
    let cumulative = 0;
    lengths.forEach((len) => {
      const dur = Math.max((len / totalLength) * totalDuration, 40);
      segs.push({ start: cumulative, dur });
      cumulative += dur;
    });

    paths.forEach((p, i) => {
      p.style.strokeDasharray = String(lengths[i]);
      p.style.strokeDashoffset = String(lengths[i]);
    });

    const start = performance.now();
    function frame(now) {
      const t = now - start;
      paths.forEach((p, i) => {
        const seg = segs[i];
        const localT = Math.min(Math.max((t - seg.start) / seg.dur, 0), 1);
        p.style.strokeDashoffset = String(lengths[i] * (1 - localT));
      });
      if (t < cumulative) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  })();

</script>

