---
import Base from '../../layouts/Base.astro';
import { useTranslations } from '../../i18n/ui';
import { Image } from 'astro:assets';
import heroPhoto from '../../assets/images/IMG_9486.JPG';
import selfiePhoto from '../../assets/images/IMG_9751.jpeg';

const t = useTranslations('en');

// PLACEHOLDER copy — replace with the couple's own wording.
const excitedHeading = "We're Getting Married!";

// Verbatim from description.md, split on blank lines into paragraphs and
// on single line breaks within a paragraph. Sectioning/layout TBD.
const letterIntro: string[][] = [
  ['Dear family and friends,'],
  [
    'After OH SO MANY years of dreaming about this moment (Lorena) and seriously worrying about our finances (Thorbjørn), the time has finally come... we’re getting married! 💍',
  ],
  [
    'Last year, during a trip to the French mountains, and after a minor crisis revolving around Lorena\'s insistence on buying the next book in the series she was reading, we found ourselves spending the night in one of the most beautiful places we have been. Good food and wine, fantastic views, and a stunning sunset, all led to the inevitable moment when Thorbjørn got down to one knee. And now, after what feels like years of planning, excitement, nerves and probably the occasional budget-related crisis, the big day is getting closer! 🥹❤️',
  ],
  ['We are so excited to share and celebrate this special day with all of you. It simply wouldn’t be the same without all the people we love.'],
];

const letterBody: string[][] = [
  [
    'The date in question is June 5th. We have found an absolutely lovely venue in the mountains north of Madrid. Yes, Madrid. As in Spain. Good weather and fantastic food. We are well aware that travelling to another country to attend a wedding is a big ask. We hope you will channel your inner Bilbo Baggins, and get ready to go on an adventure. We would love to share our day with you.',
  ],
  [
    'For now, your only mission is to save the date in your calendar (you know you want to click that convenient save the date button), and start warming up for the dance floor. We are expecting a healthy mix of questionable wedding choreography, classic party moves, enthusiastic singing along, some impressive dad dancing and, of course, whatever moves come naturally once the music starts. 💃🕺',
  ],
  ['✈️ Getting to Madrid'],
  [
    'For those of you travelling from abroad, Madrid has a large international airport, Adolfo Suárez Madrid-Barajas Airport, with plenty of connections from across Europe and beyond. So a humble request for you to start looking at flights.',
  ],
  ['🛏️ Accommodation'],
  [
    'When it comes to accommodation, there is a village 10 minutes from the venue with plenty of hotels. It won\'t surprise you to hear that we are still in the planning phase and figuring things out, but we will talk with the different establishments and try to negotiate a better price for everyone. So for now, hold off on booking a room. We’ll share more details and information with you over the coming months.',
  ],
  ['🇪🇸 Why not make a holiday out of it?'],
  [
    'If you are thinking of staying in Spain for a few extra days, or even longer, please let us know! We would absolutely love to help you plan a wonderful Spanish holiday around the wedding.',
  ],
  [
    'Whether you want to explore Madrid, discover beautiful villages, head to the coast, enjoy some Spanish food and wine, or simply find the best places to relax and enjoy the sunshine, we’ll be very happy to help you plan it. 🇪🇸☀️🍷',
  ],
];

const letterClosing: string[][] = [
  [
    'We can\'t wait for the day to come already, to see all of you looking fabulous in the mountains of Madrid, and most importantly, to celebrate with the people we love.',
  ],
  ['Lots of love and a huge hug. We can’t wait to see you! ❤️'],
  ['Lorena & Thorbjørn'],
];

// Single-line letterBody entries that should render as section headings
// rather than body text.
const sectionHeadings = new Set([
  '✈️ Getting to Madrid',
  '🛏️ Accommodation',
  '🇪🇸 Why not make a holiday out of it?',
]);

const venueName = 'Finca Prados Riveros';
const venueAddress = 'Camino del Palero 11, 28740 Rascafría, Madrid, Spain';
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(`${venueName}, ${venueAddress}`)}&output=embed`;

// Deterministic "deckled paper" edge for the photo — a slightly irregular
// outline instead of a sharp rectangle. Fixed seed so it's stable across
// rebuilds instead of reshuffling on every deploy.
function mulberry32(seed: number) {
  return function () {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function deckleEdge(seed: number) {
  const rand = mulberry32(seed);
  const perEdge = 18;
  const amp = 0.65;
  const points: string[] = [];

  const wobble = (t: number) => (Math.sin(t * Math.PI * 4 + seed) * 0.4 + (rand() - 0.5)) * amp;

  const walk = (x0: number, y0: number, x1: number, y1: number, axis: 'x' | 'y') => {
    for (let i = 0; i <= perEdge; i++) {
      const t = i / perEdge;
      const x = x0 + (x1 - x0) * t;
      const y = y0 + (y1 - y0) * t;
      const w = wobble(t + x0 + y0);
      if (axis === 'x') points.push(`${x.toFixed(2)}% ${(y + w).toFixed(2)}%`);
      else points.push(`${(x + w).toFixed(2)}% ${y.toFixed(2)}%`);
    }
  };

  walk(0, 0, 100, 0, 'x');
  walk(100, 0, 100, 100, 'y');
  walk(100, 100, 0, 100, 'x');
  walk(0, 100, 0, 0, 'y');

  return `polygon(${points.join(', ')})`;
}

const deckleClipPath = deckleEdge(7);
const mapDeckleClipPath = deckleEdge(21);
const videoDeckleClipPath = deckleEdge(41);
const selfieDeckleClipPath = deckleEdge(55);
---

<Base title="Thorbjørn & Lorena — Save the Date — 5 June 2027">
  <div class="home">
    <h2 class="excited-heading">{excitedHeading}</h2>

    <div class="photo-wrap">
      <div class="photo-frame">
        <Image src={heroPhoto} alt="Thorbjørn and Lorena" class="hero-photo" style={`clip-path: ${deckleClipPath};`} />
        <span class="corner-mount corner-mount-tl" aria-hidden="true"></span>
        <span class="corner-mount corner-mount-br" aria-hidden="true"></span>
      </div>
      <p class="photo-caption hero-caption">Lover's Bridge,<br />Brugge, 2025</p>
    </div>

    <div class="message">
      {letterIntro.map((paragraph) => (
        <p>
          {paragraph.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </p>
      ))}
    </div>

    <div class="photo-wrap video-wrap">
      <div class="photo-frame video-frame">
        <video
          class="hero-photo"
          style={`clip-path: ${videoDeckleClipPath};`}
          src="/proposal.mp4"
          poster="/proposal-poster.jpg"
          autoplay
          loop
          muted
          playsinline
        ></video>
        <span class="corner-mount corner-mount-tl" aria-hidden="true"></span>
        <span class="corner-mount corner-mount-br" aria-hidden="true"></span>
      </div>
      <p class="photo-caption video-caption">
        <a href="https://www.airbnb.com/rooms/24166990" target="_blank" rel="noopener noreferrer" class="secret-link">François' AirBnB,<br />Jouy-aux-Arches,<br />France</a>
      </p>
    </div>

    <div class="photo-wrap second-photo-wrap">
      <div class="photo-frame second-photo-frame">
        <Image src={selfiePhoto} alt="Thorbjørn and Lorena celebrating the proposal" class="hero-photo" style={`clip-path: ${selfieDeckleClipPath};`} />
        <span class="corner-mount corner-mount-tl" aria-hidden="true"></span>
        <span class="corner-mount corner-mount-br" aria-hidden="true"></span>
      </div>
      <p class="photo-caption second-photo-caption">She said yes!</p>
    </div>

    <div class="date-block">
      <div class="date-display">
        <span class="date-rule" aria-hidden="true"></span>
        <span class="date-text">5 June 2027</span>
        <span class="date-rule" aria-hidden="true"></span>
      </div>
      <div class="cta">
        <a href="/save-the-date-en.ics" download="save-the-date.ics" class="save-date-btn">{t('btn.saveTheDate')}</a>
        <span class="click-hint" aria-hidden="true">Click me!</span>
        <span class="click-hint click-hint-2" aria-hidden="true">Pretty please?</span>
      </div>
    </div>

    <div class="message">
      {letterBody.map((paragraph) => {
        const isHeading = paragraph.length === 1 && sectionHeadings.has(paragraph[0]);
        return (
          <p class={isHeading ? 'section-heading' : ''}>
            {paragraph.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))}
          </p>
        );
      })}
    </div>

    <div class="countdown" id="countdown">
      <div class="unit"><span class="number" id="days">--</span><span class="label">{t('countdown.days')}</span></div>
      <div class="sep">:</div>
      <div class="unit"><span class="number" id="hours">--</span><span class="label">{t('countdown.hours')}</span></div>
      <div class="sep">:</div>
      <div class="unit"><span class="number" id="minutes">--</span><span class="label">{t('countdown.minutes')}</span></div>
      <div class="sep">:</div>
      <div class="unit"><span class="number" id="seconds">--</span><span class="label">{t('countdown.seconds')}</span></div>
    </div>

    <div class="message closing-message">
      {letterClosing.map((paragraph) => (
        <p>
          {paragraph.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </p>
      ))}
    </div>

    <div class="venue">
      <p class="venue-name">{venueName}</p>
      <p class="venue-address">{venueAddress}</p>
      <div class="map-frame">
        <iframe
          src={mapSrc}
          width="100%"
          height="320"
          style={`border:0; clip-path: ${mapDeckleClipPath};`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Venue location"
        ></iframe>
        <span class="corner-mount corner-mount-tl" aria-hidden="true"></span>
        <span class="corner-mount corner-mount-br" aria-hidden="true"></span>
      </div>
    </div>

    <p class="lotr-note">Make haste! For it is before the mountains of Rascafría that the doom of our time will be decided</p>
  </div>
</Base>

<script>
  function update() {
    const target = new Date('2027-06-05T13:00:00+02:00'); // 13:00 CEST (Madrid)
    const diff = target.getTime() - Date.now();

    if (diff <= 0) {
      document.getElementById('countdown')!.textContent = '🎉';
      return;
    }

    const days    = Math.floor(diff / 86400000);
    const hours   = Math.floor((diff % 86400000) / 3600000);
    const minutes = Math.floor((diff % 3600000) / 60000);
    const seconds = Math.floor((diff % 60000) / 1000);

    document.getElementById('days')!.textContent    = String(days).padStart(2, '0');
    document.getElementById('hours')!.textContent   = String(hours).padStart(2, '0');
    document.getElementById('minutes')!.textContent = String(minutes).padStart(2, '0');
    document.getElementById('seconds')!.textContent = String(seconds).padStart(2, '0');
  }

  update();
  setInterval(update, 1000);
</script>

<style>
  .home {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    padding: 4rem 2rem;
    text-align: center;
    font-family: Georgia, 'Times New Roman', serif;
    color: #2c2c2c;
  }

  .excited-heading {
    font-family: 'Qwitcher Grypen', cursive;
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 400;
    color: #2c2c2c;
    margin: 0;
  }

  .photo-wrap {
    position: relative;
    width: 60%;
    max-width: 640px;
  }

  .photo-frame {
    position: relative;
    box-sizing: border-box;
    margin: 1.5rem 0;
    transform: rotate(-2deg);
  }

  .video-wrap {
    width: 40%;
    max-width: 427px;
    transform: translateX(6.5rem);
  }

  .video-frame {
    transform: rotate(2deg);
  }

  .second-photo-wrap {
    width: 30%;
    max-width: 320px;
    margin-top: -1rem;
    transform: translateX(-6.5rem);
  }

  .second-photo-frame {
    transform: rotate(-3deg);
  }

  .photo-caption {
    position: absolute;
    top: 50%;
    left: 100%;
    margin-left: 1.5rem;
    width: 190px;
    font-family: 'Homemade Apple', cursive;
    font-size: 1.3rem;
    line-height: 1.5;
    color: #a9773f;
    text-align: left;
    white-space: nowrap;
    transform: translateY(-50%) rotate(3deg);
  }

  .video-caption {
    left: auto;
    right: 100%;
    margin-left: 0;
    margin-right: 1.5rem;
    text-align: right;
    transform: translateY(-50%) rotate(-3deg);
  }

  .secret-link {
    color: inherit;
    text-decoration: none;
  }

  .secret-link:visited,
  .secret-link:hover,
  .secret-link:active,
  .secret-link:focus {
    color: inherit;
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .photo-wrap {
      width: 88%;
    }

    .video-wrap {
      width: 80%;
      transform: none;
    }

    .second-photo-wrap {
      width: 60%;
      margin-top: 0;
      transform: none;
    }

    .photo-caption {
      position: static;
      width: auto;
      margin: 0.5rem 0 0;
      text-align: center;
      white-space: normal;
    }

    .hero-caption {
      transform: rotate(1.5deg);
    }

    .second-photo-caption {
      transform: rotate(1.5deg);
    }

    .video-caption {
      transform: rotate(-1.5deg);
    }
  }

  .hero-photo {
    width: 100%;
    height: auto;
    display: block;
    /* clip-path clips the drop-shadow too, so fake depth with a filter instead */
    filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.14));
  }

  .corner-mount {
    position: absolute;
    width: 9%;
    aspect-ratio: 1;
    pointer-events: none;
    background: rgba(210, 182, 133, 0.8);
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.12));
  }

  .corner-mount-tl {
    top: 0;
    left: 0;
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  .corner-mount-br {
    bottom: 0;
    right: 0;
    clip-path: polygon(100% 100%, 0 100%, 100% 0);
  }

  .message {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 480px;
    font-size: 1rem;
    line-height: 1.7;
    color: #4a4a4a;
  }

  .message p {
    margin: 0;
  }

  .closing-message {
    gap: 2.25rem;
  }

  .message .section-heading {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #2c2c2c;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .date-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 360px;
  }

  .date-display {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    width: 100%;
  }

  .date-rule {
    flex: 1;
    height: 1px;
    max-width: 70px;
    background: #c8c0b4;
  }

  .date-text {
    font-size: 1.4rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #2c2c2c;
    white-space: nowrap;
  }

  .lotr-note {
    max-width: 560px;
    margin-top: -1.75rem;
    font-family: 'Homemade Apple', cursive;
    font-size: 1.1rem;
    line-height: 1.4;
    color: #2c2c2c;
    transform: rotate(0.8deg);
  }

  .venue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
  }

  .venue-name {
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2c2c2c;
  }

  .venue-address {
    font-size: 0.8rem;
    color: #999;
    margin-bottom: 0.5rem;
  }

  .map-frame {
    position: relative;
    width: 100%;
    max-width: 640px;
    box-sizing: border-box;
    margin: 1.5rem 0;
    line-height: 0;
    transform: rotate(-1.5deg);
  }

  .map-frame iframe {
    filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.14));
  }

  .cta {
    position: relative;
    display: inline-flex;
  }

  .save-date-btn {
    display: inline-block;
    padding: 0.65rem 2rem;
    border: 1px solid #c8c0b4;
    color: #2c2c2c;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }

  .save-date-btn:hover {
    background-color: #2c2c2c;
    color: #faf9f7;
  }

  .click-hint {
    position: absolute;
    top: 50%;
    left: 100%;
    margin-left: 1rem;
    font-family: 'Qwitcher Grypen', cursive;
    font-size: 1.9rem;
    color: #c89452;
    white-space: nowrap;
    pointer-events: none;
    animation: hint-float 2.2s ease-in-out infinite;
  }

  @keyframes hint-float {
    0%, 100% { transform: translateY(-50%) rotate(14deg); }
    50%      { transform: translateY(calc(-50% - 6px)) rotate(14deg); }
  }

  .click-hint-2 {
    top: auto;
    left: auto;
    bottom: -1.75rem;
    right: calc(100% + 0.75rem);
    margin-left: 0;
    font-size: 1.5rem;
    animation-name: hint-float-2;
    animation-delay: 0.4s;
  }

  @keyframes hint-float-2 {
    0%, 100% { transform: rotate(-8deg); }
    50%      { transform: translateY(-6px) rotate(-8deg); }
  }

  @media (max-width: 480px) {
    .cta {
      flex-direction: column;
      align-items: center;
    }

    .click-hint {
      position: static;
      display: block;
      margin: 0.5rem 0 0;
    }

    .click-hint-2 {
      animation-delay: 0.4s;
    }

    @keyframes hint-float {
      0%, 100% { transform: translateY(0) rotate(14deg); }
      50%      { transform: translateY(-6px) rotate(14deg); }
    }
  }

  .countdown {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    min-width: 3rem;
  }

  .number {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .label {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #999;
  }

  .sep {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    line-height: 1;
    color: #ccc;
  }
</style>
